{
  "components": [
    "Sprite", "Animation", "Force", "Render", "Position", 
    "Input", "Camera", "Observer", "RigidBody", "Team",
    "Follow", "Track", "Subject", "State", "Behavior",
    "Stat", "Debug", "Expiry", "Subscribe", "Name"
  ],
  "Name": {
    "func": "NameInit",
    "list": [
      {"name": "wiz", "display": "Rattagast"},
      {"name": "rat", "display": "Rat"},
      {"name": "orc", "display": "Orc"}
    ]
  },
  "Observer": {
    "func":	"ObserverInit",
    "list":	[
      {
        "name":	    "move-observer",
        "type":	    1,
        "comp":	    "Input",
        "subjects": ["INPUT-MOVE"],
        "listeners":["Animation", "Force"]
      },
      {
        "name":       "rb-observer",
        "type":       1,
        "comp":       "RigidBody",
        "subjects":   ["PHYS-VEL"],
        "listeners":  ["Position"]
      },
      {
        "name":       "pos-observer",
        "type":       1,
        "comp":       "Position",
        "subjects":   ["POS-STEP"],
        "listeners":  ["Force", "Animation"]
      },
      {
        "name":       "state-observer",
        "type":       1,
        "comp":       "State",
        "subjects":   ["BEHAVIOR-STATE"],
        "listeners":  ["Animation"]
      },
      {
        "name":       "anim-observer",
        "type":       1,
        "comp":       "Animation",
        "subjects":   ["ANIM-END"],
        "listeners":  ["State"]
      }
    ]
  },
  "Subject":  {
    "func": "SubjectInit",
    "list": [
      {
        "name":   "INPUT-MOVE",
        "type":   1,
        "comp":   "Input"
      },
      {
        "name": "PHYS-VEL",
        "type": 1,
        "comp": "RigidBody"
      },
      {
        "name":   "POS-STEP",
        "type":   1,
        "comp":   "Position"
      },
      {
        "name": "BEHAVIOR-STATE",
        "type": 1,
        "comp": "State"
      },
      {
        "name":   "ANIM-END",
        "type":   1,
        "comp":   "Animation"
      }
    ]
  },
  "Subscribe": {
    "func": "SubscriptionInit",
    "list": [
      {
        "name":     "on-hit",
        "event":    "PHYS-HIT",
        "type":     3,
        "listener": "Combat"
      }
    ]
  },
