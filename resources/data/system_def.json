{
  "systems": [
    "Controller", "Forces", "Physics", "Positions",
    "Cameras", "Animations", "Sprites", "Renderer",
    "PhysicsDebug", "Observe", "Subjects", "Combat",
    "Behavior", "State", "Team", "Event",
    "Expiration", "Debug"
  ],
  "Debug":  {
    "components": ["Debug"],
    "syncs": [
       {"step": "UPDATE_DRAW", "fn": "DebugSystem"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "DebugUse"}
    ]
  },
  "Event":  {
    "components": ["Subscribe"],
    "sets": [
      {"step": "GAME_READY", "fn": "SubscriptionSystem"}
    ]
  },
  "Observe": {
    "components": ["Observer"],
    "states": [
      {"step": "GAME_LOADING", "fn": "ObserveInit"}
    ],
    "sets": [
      {"step": "GAME_READY",   "fn": "ObserveReady"}
    ]
  },
  "Subjects": {
    "components": ["Subject"],
    "sets": [
      {"step": "GAME_LOADING",  "fn": "SubjectLoad"}
    ],
    "syncs": [
      {"step": "UPDATE_POST", "fn": "SubjectSystem"},
      {"step": "UPDATE_FINAL",  "fn": "SubjectCleanup"}
    ]
  },
  "Animations":{
    "components": ["Animation", "Sprite"],
    "syncs": [
      {"step": "UPDATE_FIXED",  "fn": "AnimSystem"}
    ],
    "sets": [
      {"step": "GAME_LOADING",  "fn": "AnimLoad"},
      {"step": "GAME_READY",    "fn": "AnimReady"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "AnimRegister"}
    ]
  },
  "Sprites" : {
    "components": ["Sprite", "Position"],
    "sets": [
      {"step": "GAME_RUNNING", "fn": "SpriteLoad"}
    ],
    "states": [
      {"step": "GAME_RUNNING", "fn": "SpritesInit"}
    ],
    "steps": [
      {"step": "UPDATE_DRAW_BEGIN", "fn": "SpriteDrawPrep"}
    ]
  },
  "Particles": {
    "components": ["Particle", "Position"],
    "syncs": [
      {"step": "UPDATE_FIXED", "fn": "ParticleSystem"},
      {"step": "UPDATE_POST", "fn": "ParticleCleanup"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "ParticlesInit"}
    ]
  },
  "ParticleEmitters": {
    "components": ["ParticleEmitter", "Position"],
    "syncs": [
      {"step": "UPDATE_FIXED", "fn": "ParticleEmitterSystem"}
    ],
    "sets": [
      {"step": "GAME_LOADING", "fn": "ParticleEmitterLoad"}
    ]
  },
  "Controller": {
    "components": ["Input"],
    "syncs": [
      {"step": "UPDATE_FRAME",  "fn": "InputSystem"}
    ],
    "sets":[
      {"step": "GAME_READY",    "fn": "InputLoad"}
    ],
    "states": [
      {"step": "GAME_LOADING",   "fn": "InputRegister"}
    ]
  },
  "Positions": {
    "components": ["Position"],
    "sets": [
      {"step": "GAME_READY",    "fn": "PositionLoad"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "PositionRegister"}
    ],
    "steps":  [
      {"step": "UPDATE_START", "fn": "PositionPrep"}
    ],
    "syncs": [
      {"step": "UPDATE_POST", "fn": "PositionSystem"}
    ],
    "iter": true
  },
  "Physics": {
    "components": ["RigidBody", "Position"],
    "syncs": [
      {"step": "UPDATE_FIXED", "fn": "PhysicsSystem"},
      {"step": "UPDATE_POST",  "fn": "PhysicsCollision", "iter": 1}
    ],
    "sets": [
      {"step": "GAME_READY",   "fn": "PhysicsLoad"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "PhysicsRegister"}
    ],
    "steps": [
      {"step": "UPDATE_START", "fn": "PhysicsPrep"}
    ],
    "iter": true
  },
  "PhysicsDebug": {
    "components": ["RigidBody", "Position"],
    "syncs": [
      {"step": "UPDATE_DRAW", "fn": "PhysicsDebug"}
    ]
  },
  "Forces": {
    "components": ["Force"],
    "syncs": [
      {"step": "UPDATE_PRE", "fn": "ForceSystem"},
      {"step": "UPDATE_FINAL", "fn": "ForceCleanup"}
    ],
    "sets": [
      {"step": "GAME_READY",    "fn": "ForceLoad"}
    ]
  },
  "Levels": {
    "components": ["Level"],
    "sets": [
      {"step": "GAME_LOADING",  "fn": "LevelLoad"},
      {"step": "GAME_READY",    "fn": "LevelReady"}
    ]
  },
  "Renderer": {
    "components": ["Render"],
    "syncs": [
      {"step": "UPDATE_DRAW",        "fn": "RenderDraw"},
      {"step": "UPDATE_DRAW_BEGIN",  "fn": "RenderBegin"},
      {"step": "UPDATE_DRAW_END",  "fn": "RenderEnd"}
    ],
    "sets": [
      {"step": "GAME_READY",   "fn": "RenderLoad"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "RenderInit"}
    ]
  },
  "Cameras": {
    "components": ["Camera", "Track"],
    "syncs": [
      {"step": "UPDATE_POST",      "fn": "CameraSystem"},
      {"step": "UPDATE_DRAW_BEGIN","fn": "CameraBegin"},
      {"step": "UPDATE_DRAW_END",  "fn": "CameraEnd"}
    ],
    "sets": [
      {"step": "GAME_LOADING", "fn": "CameraLoad"},
      {"step": "GAME_RUNNING", "fn": "CameraTarget"},
      {"step": "GAME_READY",   "fn": "CameraReady"}
    ]
  },
  "Expiration": {
    "components": ["Expiry"],
    "syncs": [
      {"step": "UPDATE_FINAL",  "fn": "ExpirationSystem"}
    ]
  },
  "Behavior": {
    "components": ["Behavior"],
    "syncs": [
      {"step": "UPDATE_PRE",  "fn": "BehaviorSystem"}
    ],
    "sets": [
      {"step": "GAME_READY", "fn": "BehaviorRegister"}
    ],
    "states": [
      {"step": "GAME_LOADING",   "fn": "BehaviorLoad"}
    ]
  },
  "State": {
    "components": ["State"],
    "sets": [
      {"step": "GAME_READY", "fn": "StateBegin"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "StateRegister"}
    ]
  },
  "Combat": {
    "components": ["Team", "Position"],
    "steps":  [
      {"step":  "UPDATE_START", "fn": "CombatPrep"}
    ],
    "states": [
      {"step": "GAME_LOADING", "fn": "CombatRegister"}
    ],
    "iter": true
  },
  "Team": {
    "components": ["Team"],
    "states": [
      {"step": "GAME_LOADING", "fn": "TeamLoad"}
    ],
    "sets": [
      {"step": "GAME_READY",   "fn": "TeamRegister"}
    ]
  }
}
