      "sets":[
        {"step": "GAME_READY",    "fn": "InputLoad"}
      ]
    },
    "Positions": {
      "components": ["Position"],
      "sets": [
        {"step": "GAME_READY",    "fn": "PositionLoad"}
      ]
    },
    "Physics": {
      "components": ["RigidBody", "Position"],
      "syncs": [
        {"step": "UPDATE_POST",  "fn": "PhysicsSystem"},
        {"step": "UPDATE_PRE" ,  "fn": "PhysicsCollision"}
